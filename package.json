{
  "name": "heretico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "tsx scripts/sync-public.ts",
    "dev": "npm run sync && next dev",
    "build": "npm run sync && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "crawl": "tsx scripts/crawl.ts",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "refresh": "npm run crawl && npm run snapshot"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
